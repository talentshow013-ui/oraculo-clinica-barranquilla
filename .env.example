# Fuente de datos del panel: "seed" (demostración) o "archivo" (datos/lote.json)
ORACULO_FUENTE=seed

# Solo para la Fase 2 (conexión con la fuente oficial de Meta desde Claude Code).
# No es necesario para correr el panel.
# (El conector oficial de Meta no necesita App ID: se autoriza con "iniciar sesión con Facebook".)

# Candado del panel cuando vive en internet (VPS). En un PC local se dejan vacíos y no pide nada.
ORACULO_USUARIO=
ORACULO_CLAVE=

# Segundos que el panel recuerda el último cálculo antes de volver a leer datos/lote.json (VPS).
ORACULO_CACHE_SEG=600

# Opcional (servidor): dónde leer el lote y dónde guardar los resultados anotados, fuera del código.
# ORACULO_RUTA_LOTE=/data/lote.json
# ORACULO_RUTA_RESULTADOS=/data/resultados.json

# Opcional: carpeta de capturas de otras ciudades (por defecto datos/referencias)
# ORACULO_RUTA_REFERENCIAS=

# Orgánico (Instagram y Facebook sin pauta), conectado directo a Meta. Los deja `npm run organico:conectar -- <token>`.
# El token es DE PÁGINA (no caduca) y vive solo aquí, nunca en el repositorio. Ver docs/CONEXION_ORGANICO.md
META_ORGANICO_TOKEN=
META_PAGINA_ID=
META_INSTAGRAM_ID=
# Opcional: id y secreto de la app de Meta (VIVANTE CLAUDE) para que el conectar extienda el token solo.
META_APP_ID=
META_APP_SECRET=
# Opcional (servidor): dónde guardar el orgánico (por defecto datos/organico.json)
# ORACULO_RUTA_ORGANICO=

# Avisos por Telegram (resumen cada mañana e informe los lunes). Bot de @BotFather; el chat se descubre con
# `npm run notificar -- --chats`. Opcional: la URL del panel para que el mensaje la incluya.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ORACULO_URL_PANEL=

# Sitio web (Google Analytics 4), solo lectura. Id numérico de la propiedad (Administrar → Detalles de la propiedad)
# y la llave JSON de la cuenta de servicio con rol Lector (guía: docs/CONEXION_GA4.md). La llave NO va al repositorio.
GA4_PROPIEDAD_ID=
GA4_CREDENCIALES=datos/ga4-credenciales.json

# Pauta de TikTok (TikTok Marketing API, solo lectura). Guía: docs/CONEXION_TIKTOK.md
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Pauta de Google Ads (Google Ads API, solo lectura). Guía: docs/CONEXION_GOOGLE_ADS.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Embudo de pacientes desde Kommo (CRM), solo lectura. Token de larga duracion de la integracion Oraculo. Guia: docs/CONEXION_KOMMO.md
KOMMO_SUBDOMINIO=
KOMMO_TOKEN=
