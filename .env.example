# Fuente de datos del panel: "seed" (demostración) o "archivo" (datos/lote.json)
ORACULO_FUENTE=seed

# Solo para la Fase 2 (conexión con la fuente oficial de Meta desde Claude Code).
# No es necesario para correr el panel.
# (El conector oficial de Meta no necesita App ID: se autoriza con "iniciar sesión con Facebook".)

# Candado del panel cuando vive en internet (VPS). En un PC local se dejan vacíos y no pide nada.
ORACULO_USUARIO=
ORACULO_CLAVE=

# Segundos que el panel recuerda el último cálculo antes de volver a leer datos/lote.json (VPS).
ORACULO_CACHE_SEG=600

# Opcional (servidor): dónde leer el lote y dónde guardar los resultados anotados, fuera del código.
# ORACULO_RUTA_LOTE=/data/lote.json
# ORACULO_RUTA_RESULTADOS=/data/resultados.json
